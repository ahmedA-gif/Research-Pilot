# ResearchPilot - Environment Configuration
# Copy this file to .env and provide your API keys if available.

# NVIDIA NIM API Settings
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_DIMENSION=2048

# Database Configuration (PostgreSQL 16 + pgvector or SQLite for local dev)
# For local Docker: postgresql+psycopg2://postgres:postgres@localhost:5432/researchpilot
# For local fallback without Postgres: sqlite:///./researchpilot.db
DATABASE_URL=sqlite:///./researchpilot.db

# API Settings
API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
